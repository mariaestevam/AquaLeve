digraph AquaLeve {
graph [rankdir=TB, bgcolor="white", nodesep=0.6, ranksep=0.85, pad=0.35, label="AquaLeve — modelo persistido revisado", labelloc=t, fontname="DejaVu Sans", fontsize=20];
node [shape=plain,fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans",fontsize=10,color="#526579",arrowsize=0.65];
Administrador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFE7"><TR><TD BGCOLOR="#DCECF3"><B>Administrador</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- idAdministrador: Integer</TD></TR><TR><TD ALIGN="LEFT">- nomeAdministrador: String</TD></TR><TR><TD ALIGN="LEFT">- telefoneAdministrador: String</TD></TR><TR><TD ALIGN="LEFT">- emailAdministrador: String</TD></TR><TR><TD ALIGN="LEFT">- senhaAdministrador: String</TD></TR></TABLE>>];
Avaliacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFE7"><TR><TD BGCOLOR="#DCECF3"><B>Avaliacao</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- idAvaliacao: Integer</TD></TR><TR><TD ALIGN="LEFT">- notaAvaliacao: Integer</TD></TR><TR><TD ALIGN="LEFT">- comentarioAvaliacao: String</TD></TR><TR><TD ALIGN="LEFT">- dataAvaliacao: LocalDate</TD></TR><TR><TD ALIGN="LEFT">- cliente: Cliente</TD></TR><TR><TD ALIGN="LEFT">- prainha: Prainha</TD></TR></TABLE>>];
Calendario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFE7"><TR><TD BGCOLOR="#DCECF3"><B>Calendario</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- idCalendario: Integer</TD></TR><TR><TD ALIGN="LEFT">- dataDisponivel: LocalDate</TD></TR><TR><TD ALIGN="LEFT">- prainha: Prainha</TD></TR></TABLE>>];
Cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFE7"><TR><TD BGCOLOR="#DCECF3"><B>Cliente</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- idCliente: Integer</TD></TR><TR><TD ALIGN="LEFT">- versaoSenha: Long</TD></TR><TR><TD ALIGN="LEFT">- cpfCliente: String</TD></TR><TR><TD ALIGN="LEFT">- nomeCliente: String</TD></TR><TR><TD ALIGN="LEFT">- emailCliente: String</TD></TR><TR><TD ALIGN="LEFT">- telefoneCliente: String</TD></TR><TR><TD ALIGN="LEFT">- senhaCliente: String</TD></TR></TABLE>>];
Eventos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFE7"><TR><TD BGCOLOR="#DCECF3"><B>Eventos</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- idEvento: Integer</TD></TR><TR><TD ALIGN="LEFT">- dataEvento: LocalDate</TD></TR><TR><TD ALIGN="LEFT">- descricaoEvento: String</TD></TR><TR><TD ALIGN="LEFT">- calendario: Calendario</TD></TR></TABLE>>];
Prainha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFE7"><TR><TD BGCOLOR="#DCECF3"><B>Prainha</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- idPrainha: Integer</TD></TR><TR><TD ALIGN="LEFT">- nomePrainha: String</TD></TR><TR><TD ALIGN="LEFT">- descricaoPrainha: String</TD></TR><TR><TD ALIGN="LEFT">- cidadePrainha: String</TD></TR><TR><TD ALIGN="LEFT">- servicosPrainha: String</TD></TR><TR><TD ALIGN="LEFT">- administrador: Administrador</TD></TR><TR><TD ALIGN="LEFT">- imagem: byte[]</TD></TR><TR><TD ALIGN="LEFT">- imagemTipo: String</TD></TR><TR><TD ALIGN="LEFT">+ isTemImagem(): boolean</TD></TR></TABLE>>];
Reserva [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFE7"><TR><TD BGCOLOR="#DCECF3"><B>Reserva</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- numeroReserva: Integer</TD></TR><TR><TD ALIGN="LEFT">- capacidadeReserva: Integer</TD></TR><TR><TD ALIGN="LEFT">- valorReserva: double</TD></TR><TR><TD ALIGN="LEFT">- tipoReserva: String</TD></TR><TR><TD ALIGN="LEFT">- disponibilidadeReserva: String</TD></TR><TR><TD ALIGN="LEFT">- dataHora: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">- status: StatusReserva</TD></TR><TR><TD ALIGN="LEFT">- entradaEm: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">- saidaEm: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">- cliente: Cliente</TD></TR><TR><TD ALIGN="LEFT">- prainha: Prainha</TD></TR></TABLE>>];
StatusReserva [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFE7"><TR><TD BGCOLOR="#DCECF3"><B>StatusReserva</B></TD></TR><HR/><TR><TD ALIGN="LEFT">CONFIRMADA</TD></TR><TR><TD ALIGN="LEFT">EM_USO</TD></TR><TR><TD ALIGN="LEFT">FINALIZADA</TD></TR><TR><TD ALIGN="LEFT">CANCELADA</TD></TR></TABLE>>];
Administrador -> Prainha [dir=none,taillabel="0..1",headlabel="0..*",label="responsável",labeldistance=2.5,labelangle=35];
Prainha -> Calendario [dir=none,taillabel="1",headlabel="0..*",label="datas liberadas",labeldistance=2.5,labelangle=35];
Calendario -> Eventos [dir=none,taillabel="1",headlabel="0..*",label="",labeldistance=2.5,labelangle=35];
Prainha -> Reserva [dir=none,taillabel="1",headlabel="0..*",label="reservas",labeldistance=2.5,labelangle=35];
Cliente -> Reserva [dir=none,taillabel="1",headlabel="0..*",label="titular",labeldistance=2.5,labelangle=35];
Cliente -> Avaliacao [dir=none,taillabel="1",headlabel="0..*",label="autor",labeldistance=2.5,labelangle=35];
Prainha -> Avaliacao [dir=none,taillabel="1",headlabel="0..*",label="avaliações",labeldistance=2.5,labelangle=35];
Reserva -> StatusReserva [style=dashed,label="status"];
{rank=same; Reserva; Avaliacao;}
{rank=same; Calendario; Eventos;}
}
