digraph Operacoes {
graph [rankdir=TB, nodesep=0.55, ranksep=0.7, pad=0.4, label="AquaLeve — responsabilidades e operações", labelloc=t, fontname="DejaVu Sans", fontsize=20];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
edge [color="#64748b",arrowsize=0.6];
AuthService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>AuthService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ login(dados: LoginForm): TokenResponse</TD></TR></TABLE>>];
ClienteService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>ClienteService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ cadastrar(form: CadastroClienteForm): Cliente</TD></TR><TR><TD ALIGN="LEFT">+ atualizarConta(id: Integer, form: ContaForm): Cliente</TD></TR><TR><TD ALIGN="LEFT">+ redefinirSenha(id: Integer, form: RedefinirSenhaForm): void</TD></TR><TR><TD ALIGN="LEFT">+ findAll(): List&lt;Cliente&gt;</TD></TR><TR><TD ALIGN="LEFT">+ deleteById(id: Integer): void</TD></TR></TABLE>>];
AdministradorService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>AdministradorService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ cadastrar(form: CadastroAdministradorForm): Administrador</TD></TR><TR><TD ALIGN="LEFT">+ atualizarConta(id: Integer, form: ContaForm): Administrador</TD></TR><TR><TD ALIGN="LEFT">+ excluir(id: Integer, idLogado: Long): void</TD></TR></TABLE>>];
PrainhaService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>PrainhaService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ save(form: PrainhaForm): Prainha</TD></TR><TR><TD ALIGN="LEFT">+ findByCidade(cidade: String): List&lt;Prainha&gt;</TD></TR><TR><TD ALIGN="LEFT">+ findById(id: Integer): Prainha</TD></TR><TR><TD ALIGN="LEFT">+ deleteById(id: Integer): void</TD></TR></TABLE>>];
ReservaService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>ReservaService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ reservar(form: ReservaForm, idCliente: Long): Reserva</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarReserva(form: ReservaAdministradorForm): Reserva</TD></TR><TR><TD ALIGN="LEFT">+ editarReserva(numero: Integer, form: ReservaAdministradorForm): Reserva</TD></TR><TR><TD ALIGN="LEFT">+ consultarDisponibilidade(idPrainha: Integer, data: LocalDate): DisponibilidadeResponse</TD></TR><TR><TD ALIGN="LEFT">+ registrarEntrada(numero: Integer): Reserva</TD></TR><TR><TD ALIGN="LEFT">+ registrarSaida(numero: Integer): Reserva</TD></TR><TR><TD ALIGN="LEFT">+ cancelar(numero: Integer, usuario: UsuarioLogado): Reserva</TD></TR><TR><TD ALIGN="LEFT">+ findByCliente(idCliente: Integer): List&lt;Reserva&gt;</TD></TR><TR><TD ALIGN="LEFT">+ findAll(): List&lt;Reserva&gt;</TD></TR></TABLE>>];
CalendarioService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>CalendarioService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ liberar(form: CalendarioForm): Calendario</TD></TR><TR><TD ALIGN="LEFT">+ datasFuturas(idPrainha: Integer): List&lt;Calendario&gt;</TD></TR><TR><TD ALIGN="LEFT">+ deleteById(id: Integer): void</TD></TR></TABLE>>];
EventosService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>EventosService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ cadastrar(form: EventoForm): Eventos</TD></TR><TR><TD ALIGN="LEFT">+ proximosDaPrainha(idPrainha: Integer): List&lt;Eventos&gt;</TD></TR><TR><TD ALIGN="LEFT">+ deleteById(id: Integer): void</TD></TR></TABLE>>];
AvaliacaoService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>AvaliacaoService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ avaliar(form: AvaliacaoForm, idCliente: Long): Avaliacao</TD></TR><TR><TD ALIGN="LEFT">+ mediaDaPrainha(idPrainha: Integer): Double</TD></TR><TR><TD ALIGN="LEFT">+ excluir(id: Integer, usuario: UsuarioLogado): Integer</TD></TR></TABLE>>];
RelatorioController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3F8FC"><TR><TD BGCOLOR="#DCECF3"><B>RelatorioController</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ relatorio(inicio: LocalDate, fim: LocalDate, model: Model): String</TD></TR><TR><TD ALIGN="LEFT">+ csv(inicio: LocalDate, fim: LocalDate): ResponseEntity&lt;byte[]&gt;</TD></TR></TABLE>>];
{rank=same; AuthService; ClienteService; AdministradorService;}
{rank=same; ReservaService; PrainhaService;}
{rank=same; CalendarioService; EventosService; AvaliacaoService;}
AuthService -> ReservaService [style=invis];
ClienteService -> PrainhaService [style=invis];
ReservaService -> CalendarioService [style=invis];
PrainhaService -> EventosService [style=invis];
ReservaService -> RelatorioController [dir=back,style=dashed,label="consulta"];
}
